{
  "manifest_version": 3,
  "name": "Rashmi AI",
  "version": "1.3.0",
  "description": "AI browsing assistant powered by Claude. Chat about any webpage, summarize content, ask questions, and more.",

  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Rashmi AI"
    }
  },

  "action": {
    "default_title": "Rashmi AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["rashmi-char.png", "popup.html", "popup.js", "welcome.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
